#!/usr/bin/env bash
# Omarchy — battery & power dashboard (interactive TUI).
# Launched from the battery-plus bar widget. Shows live battery health,
# real-time power draw (Intel RAPL), CPU power policy, TLP state, and the
# top software power consumers (PowerTOP). Offers one-key tuning.
set -uo pipefail
export LC_ALL=C

DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
. "$DIR/battery-common.sh"

TLP_DROPIN=/etc/tlp.d/01-omarchy-macbookair.conf
G=$(command -v gum || true)

title() { [ -n "$G" ] && gum style --bold --foreground 6 --border double --padding "0 2" "$1" || printf '\n=== %s ===\n' "$1"; }
hdr()   { [ -n "$G" ] && gum style --bold --foreground 4 --margin "1 0 0 0" "$1" || printf '\n-- %s --\n' "$1"; }
note()  { [ -n "$G" ] && gum style --foreground 3 "$1" || printf '%s\n' "$1"; }
kv()    { printf '  %-15s %s\n' "$1" "$2"; }

# ── live RAPL sample: package / core / gpu-uncore, 1-second window ──────
rapl_sample() {
  local doms=(intel-rapl:0 intel-rapl:0:0 intel-rapl:0:1)
  local -A a
  local dom cat_cmd=cat
  # RAPL energy_uj is root-only by default (CVE-2020-8694). Use sudo -n if
  # a udev rule has not opened it up; skip cleanly if neither works.
  if ! head -c1 /sys/class/powercap/intel-rapl:0/energy_uj >/dev/null 2>&1; then
    if sudo -n true 2>/dev/null; then cat_cmd="sudo cat"; else
      echo "  (needs root — add the udev rule from the tuning script, or run a menu action)"
      return
    fi
  fi
  for dom in "${doms[@]}"; do
    $cat_cmd "/sys/class/powercap/$dom/energy_uj" >/dev/null 2>&1 && a[$dom]=$($cat_cmd "/sys/class/powercap/$dom/energy_uj" 2>/dev/null)
  done
  [ ${#a[@]} -gt 0 ] || { echo "  (RAPL not available on this machine)"; return; }
  sleep 1
  for dom in "${doms[@]}"; do
    [ -n "${a[$dom]:-}" ] || continue
    local now max name
    now=$($cat_cmd "/sys/class/powercap/$dom/energy_uj" 2>/dev/null || echo "${a[$dom]}")
    max=$(cat "/sys/class/powercap/$dom/max_energy_range_uj" 2>/dev/null || echo 0)
    name=$(cat "/sys/class/powercap/$dom/name" 2>/dev/null || echo "$dom")
    awk -v x="${a[$dom]}" -v y="$now" -v m="$max" -v n="$name" \
      'BEGIN{d=y-x; if(d<0&&m>0)d+=m; printf "  %-15s %.2f W\n", n, d/1e6}'
  done
}

cpu_pkg_temp() {
  local z t
  for z in /sys/class/thermal/thermal_zone*; do
    [ "$(cat "$z/type" 2>/dev/null)" = x86_pkg_temp ] && t=$(cat "$z/temp" 2>/dev/null) && break
  done
  [ -n "${t:-}" ] && awk -v x="$t" 'BEGIN{printf "%.0f°C", x/1000}'
}

wifi_ps() {
  local w r=""
  for w in /sys/class/net/wl*; do
    [ -e "$w" ] || continue
    r+="$(basename "$w")=$(iw dev "$(basename "$w")" get power_save 2>/dev/null | awk '{print $NF}') "
  done
  echo "${r:-n/a}"
}

show_status() {
  clear
  title "Battery & Power  ·  MacBook Air (T2, Ice Lake)"

  hdr "Battery"
  if battery_probe; then
    kv "Charge"    "${BAT_CAP}%   (${BAT_STATUS})"
    kv "Draw now"  "$(awk -v p="$BAT_PNOW" 'BEGIN{printf "%.1f W", p/1e6}')"
    local m; m=$(battery_minutes)
    if [ -n "$m" ] && [ "$m" -gt 0 ]; then
      [ "$BAT_STATUS" = Charging ] && kv "To full" "$((m/60))h $(printf '%02d' $((m%60)))m" \
                                   || kv "Runtime" "$((m/60))h $(printf '%02d' $((m%60)))m"
    fi
    kv "Health"    "$(awk -v f="$BAT_EFULL" -v d="$BAT_EDES" 'BEGIN{printf "%.0f%%", f*100/d}')  ($(awk -v x="$BAT_EFULL" 'BEGIN{printf "%.1f",x/1e6}') / $(awk -v x="$BAT_EDES" 'BEGIN{printf "%.1f",x/1e6}') Wh design)"
    [ "${BAT_CYCLES:-0}" -gt 0 ] && kv "Cycles" "$BAT_CYCLES"
    [ -n "$BAT_TEMP_C" ] && kv "Battery temp" "${BAT_TEMP_C}°C"
    kv "AC adapter" "$([ "${AC_ONLINE:-0}" = 1 ] && echo connected || echo unplugged)"
  else
    echo "  No battery device found."
  fi

  hdr "Live power draw  (Intel RAPL, 1 s)"
  rapl_sample

  hdr "CPU power policy"
  kv "Governor"    "$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo '?')"
  kv "EPP"         "$(cat /sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference 2>/dev/null || echo '?')"
  [ -r /sys/devices/system/cpu/intel_pstate/no_turbo ] && \
    kv "Turbo boost" "$([ "$(cat /sys/devices/system/cpu/intel_pstate/no_turbo)" = 0 ] && echo on || echo off)"
  kv "Freq (avg)"  "$(awk '{s+=$1;n++} END{if(n)printf "%d MHz", s/n/1000}' /sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq 2>/dev/null)"
  kv "Pkg temp"    "$(cpu_pkg_temp || echo n/a)"
  kv "Load avg"    "$(cut -d' ' -f1-3 /proc/loadavg)"

  hdr "Power management"
  if command -v tlp >/dev/null 2>&1; then
    systemctl is-active --quiet tlp && kv "tlp.service" "active" || kv "tlp.service" "inactive (run: sudo systemctl enable --now tlp)"
    [ -r /run/tlp/last_pwr ] && kv "TLP mode" "$([ "$(cat /run/tlp/last_pwr)" = 1 ] && echo 'battery — power saving' || echo 'AC — performance')"
  else
    note "  TLP not installed. Run the tuning script (chat) for full power management."
  fi
  systemctl is-active --quiet thermald && kv "thermald" "active"
  systemctl is-active --quiet power-profiles-daemon && kv "power-profiles-daemon" "active (conflicts with TLP)"
  kv "Wi-Fi powersave" "$(wifi_ps)"
  local all on
  all=$(ls /sys/bus/pci/devices/*/power/control 2>/dev/null | wc -l)
  on=$(grep -lx on /sys/bus/pci/devices/*/power/control 2>/dev/null | wc -l)
  kv "PCI runtime PM" "$((all-on))/$all devices allow autosuspend"
  echo
}

powertop_scan() {
  command -v powertop >/dev/null 2>&1 || { note "PowerTOP is not installed."; sleep 2; return; }
  local secs=15 tmp; tmp=$(mktemp --suffix=.csv)
  note "Running PowerTOP for ${secs}s (needs sudo)…"
  sudo powertop --csv="$tmp" --time="$secs" >/dev/null 2>&1 || { note "powertop failed"; sleep 2; return; }
  hdr "Top software power consumers"
  awk -F';' '
    /Overview of Software Power Consumers/ {g=1; next}
    g && /^[[:space:]]*(;|$)/ {g=0}
    g {
      for (i=1;i<=NF;i++) gsub(/^[ \t]+|[ \t]+$/,"",$i)
      if ($1 ~ /^Usage$/ || $1=="") next
      desc=$(NF-1); if (desc=="") desc=$(NF)
      printf "  %-32s  %10s  %8s wake/s  %s\n", substr(desc,1,32), $1, $2, $NF
    }' "$tmp" | head -18
  echo
  note "Full report: $tmp"
  read -rp "  Enter to return… "
}

tips() {
  clear
  [ -n "$G" ] && gum style --bold --foreground 4 "MacBook Air 9,1 — battery tuning notes" || echo "== notes =="
  cat <<'EOF'

  Why Linux trails macOS here, biggest lever first:

  1. Display.  2560x1600 @ 1.59x is a lot of pixels; brightness is the
     single largest knob (~0.3-0.5 W per step). Lower it a notch and
     turn the keyboard backlight off when unused.

  2. Browser.  Chromium/Chrome is normally the #1 process. Fewer
     background tabs, enable its Energy Saver, check chrome://discards.

  3. Peripherals never sleeping.  Without TLP every PCIe device stays
     powered. TLP sets runtime PM = auto → roughly 1-2 W back.

  4. Wi-Fi.  Broadcom BCM4377 ships with power-save OFF; TLP enables it
     on battery.

  5. CPU energy policy.  Default is EPP "balance_power" + turbo on.
     TLP switches to EPP "power" + no turbo on battery.

  6. The T2 tax.  The Apple T2, its NVMe, and the apple-bce audio/HID
     bridge have no Linux sleep state as deep as macOS. Expect a
     permanent ~1-2 W you cannot recover. Realistic Linux idle target:
     ~7-9 W (≈ 4-5 h) vs ~5-6 W on macOS.

  7. Suspend.  mem_sleep_default=deep is already set. If standby drains
     fast, check `journalctl -b -g "PM:"` and toggle Bluetooth off
     before closing the lid.

EOF
  read -rp "  Enter to return… "
}

toggle_turbo() {
  local f=/sys/devices/system/cpu/intel_pstate/no_turbo
  [ -e "$f" ] || { note "no_turbo not available"; sleep 2; return; }
  echo "$(( 1 - $(cat "$f") ))" | sudo tee "$f" >/dev/null
  note "Turbo is now $([ "$(cat "$f")" = 0 ] && echo ON || echo OFF)"
  sleep 1
}

menu() {
  local pick
  if [ -n "$G" ]; then
    pick=$(printf '%s\n' \
      "Refresh" \
      "Scan power consumers (PowerTOP, 15s)" \
      "Battery-saver mode now" \
      "Full-power mode now" \
      "Toggle CPU turbo boost" \
      "Full TLP report" \
      "Tuning notes for this MacBook" \
      "Edit TLP config" \
      "Quit" | gum choose --header "Action")
  else
    echo; echo "  [r]efresh  [s]can  [b]at  [a]c  [t]urbo  [T]LP report  [n]otes  [e]dit  [q]uit"
    read -rp "  > " k
    case $k in r) pick=Refresh;; s) pick=Scan;; b) pick="Battery-saver mode now";; a) pick="Full-power mode now";;
      t) pick="Toggle CPU turbo boost";; T) pick="Full TLP report";; n) pick="Tuning notes for this MacBook";;
      e) pick="Edit TLP config";; *) pick=Quit;; esac
  fi
  case $pick in
    "") return 1 ;;
    Refresh) ;;
    Scan*)              powertop_scan ;;
    "Battery-saver mode now") command -v tlp >/dev/null && sudo tlp bat || note "tlp not installed"; sleep 1 ;;
    "Full-power mode now")    command -v tlp >/dev/null && sudo tlp ac  || note "tlp not installed"; sleep 1 ;;
    "Toggle CPU turbo boost") toggle_turbo ;;
    "Full TLP report")  command -v tlp-stat >/dev/null && sudo tlp-stat | ${PAGER:-less -R} || { note "tlp not installed"; sleep 2; } ;;
    "Tuning notes"*)    tips ;;
    # sudoedit runs $EDITOR/$VISUAL unprivileged against a temp copy and
    # only its own trusted copy-back step touches the real file as root —
    # unlike `sudo "$EDITOR" file`, which would execute whatever $EDITOR
    # happens to be (an ordinary, unauthenticated environment variable)
    # directly as root.
    "Edit TLP config")  sudoedit "$TLP_DROPIN" ;;
    Quit)              return 1 ;;
  esac
  return 0
}

while show_status; menu; do :; done
