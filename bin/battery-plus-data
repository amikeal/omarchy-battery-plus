#!/usr/bin/env bash
# Battery+ plugin — emit one JSON object describing battery, power draw,
# CPU policy, TLP state, tunables, and the top power-consuming processes.
# Fast (<80ms), no privileges required. RAPL is included only when the
# udev rule from power-tuning/apply.sh has made it group-readable.
set -uo pipefail
export LC_ALL=C
PATH=/usr/local/bin:/usr/bin:/bin

# ---------- battery ----------------------------------------------------
bat=""
for d in /sys/class/power_supply/BAT*; do [ -d "$d" ] && bat="$d" && break; done
g() { cat "$bat/$1" 2>/dev/null || echo "${2:-0}"; }

bat_present=false; percent=0; status=Unknown
wh_now=0; wh_full=0; wh_des=0; p_uw=0; volt=0; cycles=0; btemp=""
if [ -n "$bat" ]; then
  bat_present=true
  percent=$(g capacity)
  status=$(g status Unknown)
  volt=$(g voltage_now)
  cycles=$(g cycle_count)
  vdes=$(g voltage_min_design "$volt"); [ "${vdes:-0}" -gt 0 ] || vdes=$volt

  enow=$(g energy_now); efull=$(g energy_full); edes=$(g energy_full_design)
  pnow=$(g power_now)
  if [ "${enow:-0}" -eq 0 ] && [ "${vdes:-0}" -gt 0 ]; then
    enow=$((  $(g charge_now)          * vdes / 1000000 ))
    efull=$(( $(g charge_full)         * vdes / 1000000 ))
    edes=$((  $(g charge_full_design)  * vdes / 1000000 ))
  fi
  if [ "${pnow:-0}" -eq 0 ] && [ "${volt:-0}" -gt 0 ]; then
    cur=$(g current_now); [ "${cur:-0}" -eq 0 ] && cur=$(g current_avg); cur=${cur#-}
    pnow=$(( cur * volt / 1000000 ))
  fi
  wh_now=$enow; wh_full=$efull; wh_des=$edes; p_uw=${pnow#-}

  t=$(g temp)
  if [ "${t:-0}" -gt 0 ]; then
    if [ "$t" -gt 2000 ]; then btemp=$(awk -v x="$t" 'BEGIN{printf "%.0f", x/10-273.15}')
    else btemp=$(awk -v x="$t" 'BEGIN{printf "%.0f", x/10}'); fi
  fi
fi

ac=0
for a in /sys/class/power_supply/A{C,DP}*/online; do [ -r "$a" ] && ac=$(cat "$a") && break; done

watts=$(awk -v p="$p_uw" 'BEGIN{printf "%.2f", p/1000000}')
health=$(awk -v f="$wh_full" -v d="$wh_des" 'BEGIN{ if(d>0) printf "%.0f", f*100/d; else print 0 }')
whf=$(awk -v x="$wh_full" 'BEGIN{printf "%.1f", x/1000000}')
whd=$(awk -v x="$wh_des"  'BEGIN{printf "%.1f", x/1000000}')
frac=$(awk -v p="$percent" 'BEGIN{printf "%.3f", p/100}')
mins=0
if [ "${p_uw:-0}" -gt 0 ]; then
  case $status in
    Discharging) mins=$(awk -v e="$wh_now"  -v p="$p_uw" 'BEGIN{printf "%d", e/p*60}') ;;
    Charging)    mins=$(awk -v e="$wh_full" -v n="$wh_now" -v p="$p_uw" 'BEGIN{printf "%d", (e-n)/p*60}') ;;
  esac
fi

# ---------- RAPL (root-readable only after the udev rule) --------------
rapl_avail=false; rp_pkg=0; rp_core=0; rp_gpu=0
if head -c1 /sys/class/powercap/intel-rapl:0/energy_uj >/dev/null 2>&1; then
  declare -A E0
  for dom in intel-rapl:0 intel-rapl:0:0 intel-rapl:0:1; do
    [ -r "/sys/class/powercap/$dom/energy_uj" ] && E0[$dom]=$(cat "/sys/class/powercap/$dom/energy_uj")
  done
  if [ "${#E0[@]}" -gt 0 ]; then
    sleep 0.4
    for dom in intel-rapl:0 intel-rapl:0:0 intel-rapl:0:1; do
      [ -n "${E0[$dom]:-}" ] || continue
      e1=$(cat "/sys/class/powercap/$dom/energy_uj" 2>/dev/null || echo "${E0[$dom]}")
      mx=$(cat "/sys/class/powercap/$dom/max_energy_range_uj" 2>/dev/null || echo 0)
      w=$(awk -v a="${E0[$dom]}" -v b="$e1" -v m="$mx" 'BEGIN{d=b-a; if(d<0&&m>0)d+=m; printf "%.2f", d/1e6/0.4}')
      case $dom in
        intel-rapl:0)   rp_pkg=$w ;;
        intel-rapl:0:0) rp_core=$w ;;
        intel-rapl:0:1) rp_gpu=$w ;;
      esac
    done
    rapl_avail=true
  fi
fi

# ---------- CPU -------------------------------------------------------
gov=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo "?")
epp=$(cat /sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference 2>/dev/null || echo "?")
turbo=true
[ -r /sys/devices/system/cpu/intel_pstate/no_turbo ] && [ "$(cat /sys/devices/system/cpu/intel_pstate/no_turbo)" = 1 ] && turbo=false
freq=$(awk '{s+=$1;n++} END{if(n)printf "%d", s/n/1000}' /sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq 2>/dev/null)
pkgtemp=""
for z in /sys/class/thermal/thermal_zone*; do
  [ "$(cat "$z/type" 2>/dev/null)" = x86_pkg_temp ] && pkgtemp=$(awk -v x="$(cat "$z/temp")" 'BEGIN{printf "%.0f", x/1000}') && break
done
load1=$(cut -d' ' -f1 /proc/loadavg)

# ---------- TLP ----------------------------------------------------
tlp_installed=false; tlp_active=false; tlp_mode=unknown; tlp_manual=false
command -v tlp >/dev/null 2>&1 && tlp_installed=true
systemctl is-active --quiet tlp 2>/dev/null && tlp_active=true
# power source: the AC adapter is the ground truth; /run/tlp/last_pwr holds
# "<0|1> <changed>" (0 = AC, 1 = battery) and agrees with it.
if [ -r /run/tlp/last_pwr ]; then
  read -r lp _ < /run/tlp/last_pwr
  [ "$lp" = 1 ] && tlp_mode=battery || tlp_mode=ac
elif [ "${ac:-0}" = 1 ]; then
  tlp_mode=ac
else
  tlp_mode=battery
fi
if [ -s /run/tlp/manual_mode ]; then
  # TLP profile code: 0 = performance (tlp ac), 1 = balanced, 2 = power-saver
  # (tlp bat). Empty/absent = automatic.
  read -r mm _ < /run/tlp/manual_mode
  case $mm in
    0)     tlp_manual=true; tlp_mode=ac ;;
    1|2)   tlp_manual=true; tlp_mode=battery ;;
  esac
fi

# ---------- tunables (current runtime state) ----------------------
wifi_ps=false
for w in /sys/class/net/wl*; do
  [ -e "$w" ] || continue
  [ "$(iw dev "$(basename "$w")" get power_save 2>/dev/null | awk '{print $NF}')" = on ] && wifi_ps=true
  break
done
pci_all=$(ls /sys/bus/pci/devices/*/power/control 2>/dev/null | wc -l)
pci_auto=$(grep -lx auto /sys/bus/pci/devices/*/power/control 2>/dev/null | wc -l)
pcie_pm=false; [ "$pci_all" -gt 0 ] && [ "$pci_auto" -gt $(( pci_all / 2 )) ] && pcie_pm=true
usb_all=$(ls /sys/bus/usb/devices/*/power/control 2>/dev/null | wc -l)
usb_auto=$(grep -lx auto /sys/bus/usb/devices/*/power/control 2>/dev/null | wc -l)
usb_as=false; [ "$usb_all" -gt 0 ] && [ "$usb_auto" -gt $(( usb_all / 2 )) ] && usb_as=true
audio_ps=false
[ "$(cat /sys/module/snd_hda_intel/parameters/power_save 2>/dev/null || echo 0)" -gt 0 ] && audio_ps=true

# which tweaks are pinned in the plugin-owned TLP drop-in (survive reboot)
pin_wifi=false; pin_pcie=false; pin_usb=false; pin_audio=false
PERSIST=/etc/tlp.d/02-battery-plus.conf
if [ -r "$PERSIST" ]; then
  grep -qE '^WIFI_PWR_ON_BAT='         "$PERSIST" && pin_wifi=true
  grep -qE '^RUNTIME_PM_ON_BAT='       "$PERSIST" && pin_pcie=true
  grep -qE '^USB_AUTOSUSPEND='         "$PERSIST" && pin_usb=true
  grep -qE '^SOUND_POWER_SAVE_ON_BAT=' "$PERSIST" && pin_audio=true
fi

# ---------- sleep-drain tracking (extras/sleep-tracking) --------------
sleep_installed=false
[ -x /usr/lib/systemd/system-sleep/battery-plus-sleep ] && sleep_installed=true
sleep_json='{}'
SLEEPLOG=/var/log/battery-plus-sleep.log
if [ -r "$SLEEPLOG" ]; then
  last=$(tail -n1 "$SLEEPLOG" 2>/dev/null)
  samples=$(grep -c . "$SLEEPLOG" 2>/dev/null || echo 0)
  if [ -n "$last" ]; then
    at=$(awk '{print $1}' <<<"$last")
    dur=$(grep -oE 'duration=[0-9]+'          <<<"$last" | cut -d= -f2)
    pre=$(grep -oE 'pre_cap=[0-9]+'           <<<"$last" | cut -d= -f2)
    post=$(grep -oE 'post_cap=[0-9]+'         <<<"$last" | cut -d= -f2)
    w=$(grep -oE 'watts=[0-9.]+'              <<<"$last" | cut -d= -f2)
    pph=$(grep -oE 'pct_per_hour=-?[0-9.]+'   <<<"$last" | cut -d= -f2)
    # rolling average over the last 5 samples, so one odd short nap doesn't
    # dominate the headline number
    avgw=$(tail -n5 "$SLEEPLOG" | grep -oE 'watts=[0-9.]+'            | cut -d= -f2 | awk '{s+=$1;n++} END{if(n) printf "%.3f", s/n; else print 0}')
    avgpph=$(tail -n5 "$SLEEPLOG" | grep -oE 'pct_per_hour=-?[0-9.]+' | cut -d= -f2 | awk '{s+=$1;n++} END{if(n) printf "%.3f", s/n; else print 0}')
    sleep_json=$(jq -cn \
      --arg at "${at:-}" --argjson dur "${dur:-0}" --argjson pre "${pre:-0}" --argjson post "${post:-0}" \
      --argjson watts "${w:-0}" --argjson pph "${pph:-0}" --argjson samples "${samples:-0}" \
      --argjson avgWatts "${avgw:-0}" --argjson avgPctPerHour "${avgpph:-0}" \
      '{lastAt:$at, lastDurationSec:$dur, lastPreCap:$pre, lastPostCap:$post,
        lastWatts:$watts, lastPctPerHour:$pph, samples:$samples,
        avgWatts:$avgWatts, avgPctPerHour:$avgPctPerHour}')
  fi
fi

# ---------- Wi-Fi suspend-fix detector (extras/wifi-suspend-fix) -------
# Only flags the exact BCM4377b (Intel MacBook Air 9,1 / T2) PM-timeout bug:
# hardware present, the fix isn't already installed, and suspend_stats shows
# the specific errno -5 failure at that device — not just "this chip exists".
wifi_chip=false
lspci -nn 2>/dev/null | grep -q '14e4:4488' && wifi_chip=true
wifi_fix_installed=false
[ -x /usr/lib/systemd/system-sleep/battery-plus-wifi-suspend-fix ] && wifi_fix_installed=true
wifi_problem=false
wifi_fails=$(cat /sys/power/suspend_stats/fail 2>/dev/null || echo 0)
if [ "${wifi_fails:-0}" -gt 0 ] && [ -r /sys/power/suspend_stats/last_failed_dev ]; then
  lfd=$(cat /sys/power/suspend_stats/last_failed_dev 2>/dev/null)
  lfe=$(cat /sys/power/suspend_stats/last_failed_errno 2>/dev/null)
  if [ -n "${lfd:-}" ] && [ "$lfe" = "-5" ]; then
    dv=$(cat "/sys/bus/pci/devices/$lfd/vendor" 2>/dev/null)
    dd=$(cat "/sys/bus/pci/devices/$lfd/device" 2>/dev/null)
    [ "$dv" = "0x14e4" ] && [ "$dd" = "0x4488" ] && wifi_problem=true
  fi
fi

# ---------- top consumers (CPU% as a power proxy; helpers folded) -----
top_json=$(ps -eo comm,pcpu --no-headers 2>/dev/null \
  | awk '$1!~/^(ps|awk|sort|head|jq)$/ {a[$1]+=$2}
         END{for(k in a) if(a[k]>=0.3) printf "%.1f\t%s\n", a[k], k}' \
  | sort -rn | head -6 \
  | awk -F'\t' 'BEGIN{printf "["} {printf "%s{\"name\":\"%s\",\"pct\":%s}", (NR>1?",":""), $2, $1} END{printf "]"}')
[ -n "$top_json" ] || top_json="[]"

jq -cn \
  --argjson present "$bat_present" --argjson percent "${percent:-0}" --arg status "$status" \
  --argjson watts "$watts" --argjson health "${health:-0}" --argjson whFull "$whf" --argjson whDesign "$whd" \
  --argjson cycles "${cycles:-0}" --arg btemp "${btemp:-}" --argjson minutes "${mins:-0}" \
  --argjson ac "$ac" --argjson frac "$frac" \
  --argjson raplAvail "$rapl_avail" --argjson rpkg "$rp_pkg" --argjson rcore "$rp_core" --argjson rgpu "$rp_gpu" \
  --arg gov "$gov" --arg epp "$epp" --argjson turbo "$turbo" --argjson freq "${freq:-0}" \
  --arg pkgtemp "${pkgtemp:-}" --argjson load1 "${load1:-0}" \
  --argjson tlpInstalled "$tlp_installed" --argjson tlpActive "$tlp_active" --arg tlpMode "$tlp_mode" --argjson tlpManual "$tlp_manual" \
  --argjson wifi "$wifi_ps" --argjson usb "$usb_as" --argjson pcie "$pcie_pm" --argjson audio "$audio_ps" \
  --argjson pinWifi "$pin_wifi" --argjson pinUsb "$pin_usb" --argjson pinPcie "$pin_pcie" --argjson pinAudio "$pin_audio" \
  --argjson top "$top_json" \
  --argjson sleep "$sleep_json" --argjson sleepInstalled "$sleep_installed" \
  --argjson wifiChip "$wifi_chip" --argjson wifiFixInstalled "$wifi_fix_installed" \
  --argjson wifiProblem "$wifi_problem" --argjson wifiFails "${wifi_fails:-0}" \
  '{
    battery: { present:$present, percent:$percent, status:$status, watts:$watts, health:$health,
               whFull:$whFull, whDesign:$whDesign, cycles:$cycles, tempC:$btemp, minutes:$minutes,
               acOnline:$ac, fraction:$frac },
    rapl:   { available:$raplAvail, package:$rpkg, core:$rcore, gpu:$rgpu },
    cpu:    { governor:$gov, epp:$epp, turbo:$turbo, freqMHz:$freq, pkgTempC:$pkgtemp, load1:$load1 },
    tlp:    { installed:$tlpInstalled, active:$tlpActive, mode:$tlpMode, manual:$tlpManual },
    tweaks: { wifi:$wifi, usb:$usb, pcie:$pcie, audio:$audio,
              wifiPinned:$pinWifi, usbPinned:$pinUsb, pciePinned:$pinPcie, audioPinned:$pinAudio },
    top:    $top,
    sleep:  ($sleep + {installed:$sleepInstalled}),
    wifiFix: { chipPresent:$wifiChip, installed:$wifiFixInstalled, problemSeen:$wifiProblem, failCount:$wifiFails }
  }'
