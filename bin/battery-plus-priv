#!/usr/bin/env bash
# Battery+ — privileged actions. power-tuning/apply.sh installs a copy of
# this file to /usr/local/bin/battery-plus-priv (root:root, 0755) and
# whitelists THAT path in /etc/sudoers.d/battery-plus. Every branch is a
# fixed operation on a fixed sysfs path; no caller-supplied string is ever
# executed or used to build a path.
set -euo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

want() { case "$1" in on|off) return 0 ;; *) echo "bad arg" >&2; exit 2 ;; esac; }

# Plugin-owned TLP drop-in — sorts after 01-*, so its keys win. Only the
# lines the panel pins live here; removing a pin removes its line and TLP
# falls back to 01-* / its own defaults.
PERSIST=/etc/tlp.d/02-battery-plus.conf

# tweak -> "KEY on-value off-value" (battery profile; that is where it matters)
tlp_key() {
  case "$1" in
    wifi)  echo "WIFI_PWR_ON_BAT on off" ;;
    pcie)  echo "RUNTIME_PM_ON_BAT auto on" ;;
    usb)   echo "USB_AUTOSUSPEND 1 0" ;;
    audio) echo "SOUND_POWER_SAVE_ON_BAT 1 0" ;;
    *) return 1 ;;
  esac
}

persist_header() {
  [ -s "$PERSIST" ] && return
  printf '# Managed by the Battery+ plugin — pinned device-power settings.\n# Delete a line (or unpin it in the panel) to fall back to TLP defaults.\n\n' > "$PERSIST"
}

upsert() { # file KEY value
  persist_header
  if grep -qE "^$2=" "$1"; then
    sed -i "s|^$2=.*|$2=$3|" "$1"
  else
    printf '%s=%s\n' "$2" "$3" >> "$1"
  fi
}

case "${1:-}" in
  tlp-auto) exec tlp start ;;
  tlp-bat)  exec tlp bat ;;
  tlp-ac)   exec tlp ac ;;

  turbo)
    want "${2:-}"
    [ "$2" = on ] && v=0 || v=1
    echo "$v" > /sys/devices/system/cpu/intel_pstate/no_turbo
    ;;

  epp)
    case "${2:-}" in
      power|balance_power|balance_performance|performance) ;;
      *) echo "bad epp" >&2; exit 2 ;;
    esac
    for f in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do
      echo "$2" > "$f" 2>/dev/null || true
    done
    ;;

  wifi)
    want "${2:-}"
    for d in /sys/class/net/wl*; do
      [ -e "$d" ] || continue
      iw dev "$(basename "$d")" set power_save "$2" || true
    done
    ;;

  audio)
    want "${2:-}"
    [ "$2" = on ] && echo 10 > /sys/module/snd_hda_intel/parameters/power_save \
                  || echo 0  > /sys/module/snd_hda_intel/parameters/power_save
    ;;

  pcie)
    want "${2:-}"
    [ "$2" = on ] && v=auto || v=on
    for f in /sys/bus/pci/devices/*/power/control; do echo "$v" > "$f" 2>/dev/null || true; done
    ;;

  usb)
    want "${2:-}"
    [ "$2" = on ] && v=auto || v=on
    for f in /sys/bus/usb/devices/*/power/control; do
      dev=$(dirname "$f")
      # never autosuspend HID (keyboards, mice, trackpads, fingerprint readers)
      if grep -qsx 03 "$dev"/*/bInterfaceClass 2>/dev/null; then continue; fi
      echo "$v" > "$f" 2>/dev/null || true
    done
    ;;

  persist)
    # persist <tweak> <on|off>: write the pinned value and re-apply TLP
    want "${3:-}"
    read -r key onv offv <<<"$(tlp_key "${2:-}")" || { echo "bad tweak" >&2; exit 2; }
    [ "$3" = on ] && upsert "$PERSIST" "$key" "$onv" || upsert "$PERSIST" "$key" "$offv"
    tlp start >/dev/null 2>&1 || true
    ;;

  unpersist)
    # unpersist <tweak>: drop the pinned line, back to TLP defaults
    read -r key _ _ <<<"$(tlp_key "${2:-}")" || { echo "bad tweak" >&2; exit 2; }
    [ -f "$PERSIST" ] && sed -i "/^$key=/d" "$PERSIST"
    # if nothing but the header remains, remove the file
    [ -f "$PERSIST" ] && ! grep -qE '^[A-Z]' "$PERSIST" && rm -f "$PERSIST"
    tlp start >/dev/null 2>&1 || true
    ;;

  *) echo "unknown action: ${1:-}" >&2; exit 2 ;;
esac

echo ok
